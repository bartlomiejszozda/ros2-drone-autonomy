<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>collider</name>
  <version>0.1.0</version>
  <description>Vision-guided drone control on ROS 2 with ArduPilot SITL and Gazebo: target tracking, visual-servoing steering, safety supervision, mission orchestration and YOLO vehicle detection.</description>
  <maintainer email="bartekszozda19@gmail.com">Bartlomiej Szozda</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>ardupilot_msgs</depend>
  <depend>collider_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
